# Копирай като .env и попълни стойностите.
# Празна стойност = използва се default-ът от docker-compose.yml (показан в скобите).

# Порт на уеб интерфейса (8080)
APP_PORT=

# Достъп до PostgreSQL (accountant / accountant / accountant)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Локален модел в Ollama (qwen2.5:7b). Добри варианти:
#   qwen2.5:7b    (~4.7 GB, добър JSON и български, работи и на CPU)
#   qwen2.5:14b   (~9 GB, по-точен, препоръчително с GPU)
#   qwen2.5:3b    (~2 GB, бърз, по-неточен)
LLM_MODEL=
# Контекст на модела в токени (8192)
LLM_NUM_CTX=
# Таймаут за обработка на документ в секунди (900)
LLM_TIMEOUT_SECONDS=
# Таг на образа ollama/ollama (latest)
OLLAMA_TAG=

# Валута на счетоводството (EUR; от 01.01.2026 в България е EUR)
BOOK_CURRENCY=
# Езици за OCR (bul+eng)
OCR_LANG=
